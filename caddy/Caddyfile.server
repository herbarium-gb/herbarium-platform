{
    # email you@example.com
}

{$HOST_PROD} {
    root * /srv_prod
    encode gzip

    @health path /health
    handle @health {
        header Content-Type text/plain
        respond "ok\n" 200
    }

    # IIIF info.json — cache kort (innehåller bildmått, ändras ej)
    @iiif_info path_regexp ^/iiif/.*/info\.json$
    handle @iiif_info {
        header Cache-Control "public, max-age=86400"
        reverse_proxy iiif_prod:12415 {
            header_up Host {hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # IIIF bildregioner — cache en vecka, revaliderar därefter (self-heal om en bild rättas)
    handle /iiif* {
        header Cache-Control "public, max-age=604800"
        reverse_proxy iiif_prod:12415 {
            header_up Host {hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Shard index — must reflect new images immediately, so revalidate every time
    @idx path /idx/*
    handle @idx {
        header Cache-Control "no-cache"
        file_server
    }

    @static path_regexp static ^/(assets/|favicon\.ico$|robots\.txt$)
    handle @static {
        try_files {path} {path}/index.html
        header Cache-Control "public, max-age=604800"
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    log {
        level warn
        output stdout
        format console
    }
}

{$HOST_STAGE} {
    root * /srv_stage
    encode gzip

    @health path /health
    handle @health {
        header Content-Type text/plain
        respond "ok\n" 200
    }

    @iiif_info path_regexp ^/iiif/.*/info\.json$
