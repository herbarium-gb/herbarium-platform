            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /iiif* {
        header Cache-Control "public, max-age=604800"
        reverse_proxy iiif_stage:12415 {
            header_up Host {hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Shard index — must reflect new images immediately, so revalidate every time
    @idx path /idx/*
    handle @idx {
        header Cache-Control "no-cache"
        file_server
    }

    @static path_regexp static ^/(assets/|favicon\.ico$|robots\.txt$)
    handle @static {
        try_files {path} {path}/index.html
        header Cache-Control "public, max-age=604800"
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    log {
        level warn
        output stdout
        format console
    }
}
