{
    # email you@example.com
}

# IIIF rules shared by prod and stage.
# Usage: import iiif <RAIS service>
(iiif) {
    # Short image URLs: /GB-1155095.jpg is served directly (no redirect, so the
    # short URL stays in the address bar) from
    # /iiif/{rel}/GB-1155095.jp2/full/,3500/0/default.jpg
    # {rel} is looked up in the same shard file the viewer reads (/idx/<shard>.json).
    # The shard key (group 2) must match shardKeyFor() in viewer/*/index.html:
    # 7 characters (GB-1155), or 14 for GB-Folder_ IDs (GB-Folder_0018).
    @iiif_short path_regexp short ^/((GB-(?:Folder_)?\d{4})\d{3})\.jpg$
    handle @iiif_short {
        intercept {
            @found header X-Rel *
            handle_response @found {
                # Drop headers inherited from the lookup response below (text/plain, length 0)
                header -X-Rel
                header -Content-Length
                header {
                    Content-Type image/jpeg
                    Cache-Control "public, max-age=604800"
                    match status 2xx
                }
                rewrite * /iiif/{resp.header.X-Rel}/{re.short.1}.jp2/full/,3500/0/default.jpg
                reverse_proxy {args[0]}:12415 {
                    header_up Host {hostport}
                    header_up X-Real-IP {remote_host}
                    header_up X-Forwarded-For {remote_host}
                    header_up X-Forwarded-Proto {scheme}
                }
            }
            handle_response {
                header -Content-Length
                respond "Image not found" 404
            }
        }
        templates
        respond `{{ $f := printf "/idx/%s.json" (placeholder "http.regexp.short.2") }}{{ if fileExists $f }}{{ with index (include $f | fromJson) (placeholder "http.regexp.short.1") }}{{ $.RespHeader.Set "X-Rel" . }}{{ end }}{{ end }}` 200
    }

    # Block expensive sizes (CPU ceiling ~0.5 images/s). Allowed size field:
    # w,  ,h  w,h  !w,h  with at most 3999 px. Everything else — full, max, pct:,
    # ^ (upscaling) and numbers ≥ 4000 — gets 403. The region is not restricted,
    # so viewer tiles (e.g. 0,0,4096,4096/1024,) and the downloads
    # full/1200, and full/3400, keep working. info.json is not affected.
    @iiif_size_denied {
        path_regexp \.jp2/[^/]+/[^/]+/[^/]+/[^/]+$
        not path_regexp \.jp2/[^/]+/!?(?:\d{1,3}|[1-3]\d{3})?,(?:\d{1,3}|[1-3]\d{3})?/[^/]+/[^/]+$
    }
    handle @iiif_size_denied {
        respond "Image size not allowed (max 3999 px)" 403
    }

    # IIIF info.json — cache for a day (holds image dimensions, which don't change)
    @iiif_info path_regexp ^/iiif/.*/info\.json$
    handle @iiif_info {
        header {
            Cache-Control "public, max-age=86400"
            match status 2xx
        }
        reverse_proxy {args[0]}:12415 {
            header_up Host {hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # IIIF image regions — cache for a week, then revalidate (self-heals if an image is fixed).
    # Only 2xx is cached, so a transient error (502 while RAIS restarts) doesn't stick in the browser.
    handle /iiif* {
        header {
            Cache-Control "public, max-age=604800"
            match status 2xx
        }
        reverse_proxy {args[0]}:12415 {
            header_up Host {hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

{$HOST_PROD} {
    root * /srv_prod
    encode gzip

    @health path /health
    handle @health {
        header Content-Type text/plain
        respond `ok
` 200
    }

    import iiif iiif_prod

    # Shard index — must reflect new images immediately, so revalidate every time
    @idx path /idx/*
    handle @idx {
        header Cache-Control "no-cache"
        file_server
    }

    @static path_regexp static ^/(assets/|favicon\.ico$|robots\.txt$)
    handle @static {
        try_files {path} {path}/index.html
        header Cache-Control "public, max-age=604800"
        file_server
    }

    handle {
        try_files {path} {path}/index.html /index.html
        file_server
    }

    log {
        level warn
        output stdout
        format console
    }
}

{$HOST_STAGE} {
    root * /srv_stage
    encode gzip

    @health path /health
    handle @health {
        header Content-Type text/plain
        respond `ok
` 200
    }

    import iiif iiif_stage

    # Shard index — must reflect new images immediately, so revalidate every time
    @idx path /idx/*
    handle @idx {
        header Cache-Control "no-cache"
        file_server
    }

    @static path_regexp static ^/(assets/|favicon\.ico$|robots\.txt$)
    handle @static {
        try_files {path} {path}/index.html
        header Cache-Control "public, max-age=604800"
        file_server
    }

    handle {
        try_files {path} {path}/index.html /index.html
        file_server
    }

    log {
        level warn
        output stdout
        format console
    }
}
